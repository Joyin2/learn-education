# ==============================================================================
# Learn Education - environment template
#
# Copy this file to `.env.local` and fill in the values for your own Firebase
# project, then restart the dev server:
#
#   cp .env.example .env.local
#
# `.env.local` is gitignored; this template is committed so anyone setting the
# project up knows which variables are required.
#
# Every variable is NEXT_PUBLIC_, meaning it is inlined into the browser bundle.
# Do not put real secrets (service account keys, private API keys) in here - they
# would be readable by any visitor. Server-only secrets must NOT use the
# NEXT_PUBLIC_ prefix.
# ==============================================================================


# ------------------------------------------------------------------------------
# Firebase (required)
# Firebase Console > Project settings > Your apps > SDK setup and configuration
# Without these the app cannot reach Firestore or authenticate the admin user.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000


# ------------------------------------------------------------------------------
# Site (required)
# Canonical public URL, no trailing slash.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://your-domain.co.uk


# ------------------------------------------------------------------------------
# Supabase storage (required)
# Base URL of the bucket serving site imagery.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://your-project.supabase.co


# ------------------------------------------------------------------------------
# Development flags (optional)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_USE_MOCK_DATA=false
